model Media {
  id        String     @id @default(uuid())
  type      String
  data      Bytes
  tableId   String? // No strict constraint
  tableType TableTypes

  // Optional foreign keys to Event, Society, and User
  event   Event?  @relation(fields: [eventId], references: [eventId])
  eventId String?

  society   Society? @relation(fields: [societyId], references: [societyId])
  societyId String?  @unique

  user   User?   @relation(fields: [userId], references: [userId])
  userId String? @unique
  landingCard     LandingCard?  @relation(fields: [landingCardId], references: [landingCardId])
  landingCardId   String?       @unique
  sliderCard      SliderCard?   @relation(fields: [sliderCardId],  references: [sliderCardId])
  sliderCardId    String?       @unique
  @@index([tableId])
}

enum TableTypes {
  user
  society
  event
  landingPage
}
