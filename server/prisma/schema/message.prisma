model Message {
  messageId String   @id @default(uuid())
  message   String
  timeStamp DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [userId])
  societyId String
  //   society    Society  @relation(fields: [societyId], references: [societyId])
  mediaId   String?
  isDeleted Boolean  @default(false)
}
