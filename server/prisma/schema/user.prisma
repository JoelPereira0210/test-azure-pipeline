model User {
  userId                     String                 @id @default(uuid())
  phoneNumber                String                 @unique @db.VarChar(20)
  firstName                  String                 @db.VarChar(255)
  lastName                   String                 @db.VarChar(255)
  gender                     String?                @db.VarChar(255)
  password                   String?                @db.VarChar(255)
  address                    String?                @db.VarChar(255)
  state                      Json?
  country                    Json?
  pincode                    String?                @db.VarChar(6)
  isAdmin                    Boolean
  membershipStatusId         BigInt?
  buildingDoorNumber         String?                @db.VarChar(255)
  flatNumber                 String?                @db.VarChar(255)
  streetName                 String?                @db.VarChar(255)
  profilePictureId           String?                @unique
  isDeleted                  Boolean                @default(false)
  bankAccountCreated         BankDetails[]          @relation("BankAccountCreator")
  bankAccountEdited          BankDetails[]          @relation("BankAccountEditor")
  committeeRoleCreatorMaster CommitteeRoleMaster[]  @relation("RoleCreator")
  committeeRoleEditorMaster  CommitteeRoleMaster[]  @relation("RoleEditor")
  SubscriptionPayments       SubscriptionPayments[] @relation("SubscriptionPayments")
  Society                    Society[]              @relation("SocietyCreator")
  societyMembers             SocietyMember[]
  membershipStatus           MembershipStatus?      @relation(fields: [membershipStatusId], references: [id])
  // profilePicture             Media[]                @relation("UserMediaRelation")
  profilePicture             Media[]
  EventCreator               Event[]                @relation("EventCreator")

  EventEditor Event[]   @relation("EventEditor")
  messages    Message[]

  SubscriptionMasterCreator SubscriptionMaster[] @relation("SubscriptionCreator")

  SubscriptionMasterEditor SubscriptionMaster[] @relation("SubscriptionEditor")

  societySubscription societySubscription[] @relation("SocietySubscriptionBuyer")

  CouponCreated Coupons[] @relation("CouponCreator")

  CouponEdited Coupons[] @relation("CouponEditor")
}
